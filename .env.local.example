# PostHog — https://posthog.com/docs/libraries/next-js
# Project token: PostHog → Project settings → Project API key
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here

# Reverse proxy path (configured in next.config.ts). Use /wc26-ph or another unique path.
NEXT_PUBLIC_POSTHOG_API_HOST=/wc26-ph

# PostHog app URL for toolbar / session links (EU cloud)
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# Proxy region: eu (default) or us — controls next.config.ts rewrite destinations
POSTHOG_REGION=eu
